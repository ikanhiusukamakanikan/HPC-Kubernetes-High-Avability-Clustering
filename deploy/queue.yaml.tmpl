apiVersion: v1
kind: Namespace
metadata:
  name: hpc
  labels:
    hpc.local/queue: enabled
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: ResourceFlavor
metadata:
  name: hpc-compute
spec:
  nodeLabels:
    hpc.local/role: compute
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: ClusterQueue
metadata:
  name: hpc-queue
spec:
  queueingStrategy: StrictFIFO
  namespaceSelector:
    matchLabels:
      hpc.local/queue: enabled
  resourceGroups:
    - coveredResources: [cpu, memory]
      flavors:
        - name: hpc-compute
          resources:
            - name: cpu
              nominalQuota: ${QUEUE_CPU_M}m
            - name: memory
              nominalQuota: ${QUEUE_MEMORY_MIB}Mi
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  name: hpc
  namespace: hpc
spec:
  clusterQueue: hpc-queue
